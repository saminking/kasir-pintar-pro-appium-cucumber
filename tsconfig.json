{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/cucumber-framework"
    ]
  },
  "include": [
    "wdio.conf.ts",
    "src/**/*.ts"
  ]
}
