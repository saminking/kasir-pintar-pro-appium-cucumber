# Appium connection. The local Appium service is started automatically by default.
APPIUM_SERVER_URL=http://127.0.0.1:4723/
USE_EXTERNAL_APPIUM=false

# Android device or emulator.
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_UDID=
ANDROID_PLATFORM_VERSION=

# Official Kasir Pintar Pro package ID from Google Play.
ANDROID_APP_PACKAGE=org.owline.kasirpintarpro
ANDROID_APP_ACTIVITY=
ANDROID_APP_PATH=
ANDROID_NO_RESET=true
ANDROID_AUTO_GRANT_PERMISSIONS=true

# Runtime behavior.
WAIT_TIMEOUT_MS=20000
CUCUMBER_TIMEOUT_MS=120000
CUCUMBER_TAGS=not @manual
LOG_LEVEL=info

# Optional Appium Inspector selector overrides.
# Values are raw WebdriverIO selectors, for example:
# id=org.owline.kasirpintarpro:id/btn_save
# ~Simpan
KP_SELECTOR_MENU_PRODUCTS=
KP_SELECTOR_ADD_PRODUCT=
KP_SELECTOR_SEARCH_INPUT=
KP_SELECTOR_NAME_INPUT=
KP_SELECTOR_STOCK_INPUT=
KP_SELECTOR_CODE_INPUT=
KP_SELECTOR_BASE_PRICE_INPUT=
KP_SELECTOR_SELLING_PRICE_INPUT=
KP_SELECTOR_SAVE_PRODUCT=
KP_SELECTOR_EDIT_PRODUCT=
KP_SELECTOR_DELETE_PRODUCT=
KP_SELECTOR_CONFIRM_DELETE=
